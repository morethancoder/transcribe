{
	"name": "transcrape",
	"version": "0.1.0",
	"description": "On-device video and audio transcription, powered by whisper.cpp",
	"license": "MIT",
	"private": true,
	"type": "module",
	"homepage": "https://github.com/morethancoder/transcrape",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/morethancoder/transcrape.git"
	},
	"bugs": {
		"url": "https://github.com/morethancoder/transcrape/issues"
	},
	"keywords": [
		"transcription",
		"whisper",
		"whisper.cpp",
		"subtitles",
		"srt",
		"offline",
		"sveltekit"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"morethanui": "^1.0.0"
	}
}
