# All optional — the app finds the media binaries itself and downloads the
# models on demand. Copy to .env and uncomment only what you need to override.

# --- Media tools ------------------------------------------------------------
# Looked up on the PATH, plus the usual package-manager prefixes:
#   macOS  /opt/homebrew/bin, /usr/local/bin, /usr/bin
#   Linux  /usr/local/bin, /usr/bin, /bin, /snap/bin, ~/.local/bin
#   Windows  PATH only — set these explicitly if the installer didn't add one
#WHISPER_CLI=/opt/homebrew/bin/whisper-cli
#FFMPEG=/opt/homebrew/bin/ffmpeg
#FFPROBE=/opt/homebrew/bin/ffprobe

# --- Models -----------------------------------------------------------------
# Transcription model — fast, but cannot translate
#WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
#WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin

# Translation model — downloaded the first time someone translates a transcript.
# Swap in ggml-large-v3-q5_0.bin (~1.1 GB) for better translations, at ~2x the time.
#WHISPER_TRANSLATE_MODEL=models/ggml-medium-q5_0.bin
#WHISPER_TRANSLATE_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium-q5_0.bin

# --- Job retention ----------------------------------------------------------
# How long the decoded audio of a finished job stays on disk so it can be
# translated without re-uploading (default 6 hours), and how many are kept.
#JOB_TTL_MS=21600000
#MAX_JOBS=20

# --- Server (production build only — `make start` or a dist archive) ---------
# The dev server always uses vite's own host/port.
#HOST=127.0.0.1
#PORT=5173
# Uploads are whole video files, so the launchers raise adapter-node's 512 kB
# default. Set a byte count here to cap it instead.
#BODY_SIZE_LIMIT=Infinity
